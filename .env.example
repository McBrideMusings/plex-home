# Copy to .env (gitignored) and fill in. Used by the admin task runner only.

# Docker image name built locally and loaded onto the host
APP_IMAGE=plex-home:latest

# Host that runs the container
UNRAID_HOST=<host-or-ip>
UNRAID_USER=root

# Directory on that host holding config.yaml and pin_history.json.
# deploy/appdata/ in this repo mirrors it; `admin deploy files` rsyncs it up.
PLEX_HOME_APPDATA=/mnt/user/appdata/plex-home

# Set to true only when running admin ON the host (skips SSH, acts locally)
DEPLOY_LOCAL=
