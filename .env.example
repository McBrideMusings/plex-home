# Copy to .env (gitignored) and fill in.

# Docker image name built locally and loaded onto the host
APP_IMAGE=plex-home:latest

# Host that runs the container
UNRAID_HOST=<host-or-ip>
UNRAID_USER=root

# Directory on that host holding config.yaml and pin_history.json.
# deploy/appdata/ in this repo mirrors it.
PLEX_HOME_APPDATA=<path-to-appdata>/plex-home

# Set to true only when running on the host itself (acts locally, skips SSH)
DEPLOY_LOCAL=
